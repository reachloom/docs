---
import DocsLayout from "../layouts/DocsLayout.astro";
import { LinkButton } from "../components/ui/link-button";
import { Card } from "../components/ui/card";
import { CardGrid } from "../components/ui/card-grid";
import { Aside } from "../components/ui/aside";
import { getSidebar } from "@cloudflare/nimbus-docs";
import { config } from "virtual:nimbus/config";

const sidebar = await getSidebar("/", { collection: "docs" });
---

<DocsLayout title={config.title} description={config.description} sidebar={sidebar} headings={[]} breadcrumbs={[]} prevNext={{}}>
  <Fragment slot="pagination" />
  <Fragment slot="page-title">
    <div class="py-4 sm:py-8">
      <img
        src={`${import.meta.env.BASE_URL}logo.svg`}
        alt=""
        width="56"
        height="56"
        class="size-14 object-contain"
      />
      <h1
        class="mt-5 text-foreground leading-tight [text-wrap:balance]"
        style="font-size: clamp(2.25rem, 4vw, 2.75rem); font-weight: var(--nb-h1-weight); letter-spacing: var(--nb-h1-tracking);"
      >
        Find leads and run outreach
      </h1>
      <p class="mt-3 max-w-xl text-[1.0625rem] text-muted-foreground leading-relaxed [text-wrap:pretty]">
        Reachloom helps you find pages that fit your product, write to the people
        behind them, and handle replies. Learn how to set up campaigns, review
        emails, and track results.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <LinkButton href="/getting-started" variant="primary" size="lg" icon>
          Get started
        </LinkButton>
        <LinkButton
          href="https://my.reachloom.app"
          variant="outline"
          size="lg"
          target="_blank"
          rel="noopener"
        >
          Open Reachloom
        </LinkButton>
      </div>
    </div>
  </Fragment>

  <h2>Quickstart</h2>
  <ol>
    <li><a href="https://my.reachloom.app">Open Reachloom</a> and sign in.</li>
    <li>Create a workspace and check your product profile.</li>
    <li>Create a <strong>Campaign</strong>, choose an ask, and find fitting pages.</li>
    <li><a href="/publishing/gmail">Connect Gmail</a>, then <a href="/publishing/sending">review your email drafts</a>.</li>
  </ol>

  <Aside type="tip" title="Using an AI agent?">
    Connect Claude, Cursor, or another agent with <a href="/ai/mcp">MCP</a> and ask it to
    read your workspace and prepare campaigns and email drafts.
  </Aside>

  <h2>Explore the docs</h2>
  <CardGrid>
    <Card title="Get started" icon="ph:rocket-launch" href="/getting-started">
      Set up your first outreach campaign.
    </Card>
    <Card title="Campaigns" icon="ph:megaphone" href="/tools">
      Campaign briefs, pages, lead search, and automation.
    </Card>
    <Card title="Email and results" icon="ph:envelope" href="/publishing">
      Connect Gmail, review drafts, and handle conversations.
    </Card>
    <Card title="AI and MCP" icon="ph:robot" href="/ai">
      Use workspace chat or connect an agent to prepare work.
    </Card>
  </CardGrid>
</DocsLayout>
